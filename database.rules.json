{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      "$session": {
        "public": {
          ".read": "auth != null && $session.matches(/^[A-Za-z0-9_-]{16,64}$/)",
          ".write": "auth != null && auth.uid === 'REPLACE_WITH_FIREBASE_DIRECTOR_UID' && $session.matches(/^[A-Za-z0-9_-]{16,64}$/)",
          ".validate": "newData.hasChildren(['scene','paused','version','updatedAt']) && newData.childrenCount() === 4",
          "scene": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11 && newData.val() % 1 == 0"
          },
          "paused": {
            ".validate": "newData.isBoolean()"
          },
          "version": {
            ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 1 && (!data.parent().exists() || newData.val() > data.parent().child('version').val())"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 600000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
